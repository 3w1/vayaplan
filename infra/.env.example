# ==============================================================================
# VayaPlan — Configuración de Variables de Entorno (.env.example)
# Copia este archivo a .env y define los valores reales antes de arrancar.
# En producción, todos los secretos señalados como [OBLIGATORIO EN PRODUCCIÓN]
# son estrictamente requeridos. La aplicación no arrancará si alguno falta.
# ==============================================================================

# Entorno general
NODE_ENV=production
PORT=4000
APP_URL=https://vayaplan.com
API_URL=https://vayaplan.com/api

# Base de datos PostgreSQL 16
# [OBLIGATORIO EN PRODUCCIÓN]: POSTGRES_PASSWORD y DATABASE_URL
POSTGRES_DB=vayaplan
POSTGRES_USER=vayaplan_user
POSTGRES_PASSWORD=
DATABASE_URL=

# Cloudflare R2 (Almacenamiento multimedia y optimización WebP)
# Requerido para almacenamiento y optimización de carteles en producción
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=vayaplan-media
R2_PUBLIC_URL=https://media.vayaplan.com

# Integración WhatsApp Business
# [OBLIGATORIO EN PRODUCCIÓN]: WHATSAPP_WEBHOOK_SECRET
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_WEBHOOK_SECRET=

# Medición y métricas anónimas
ANALYTICS_WRITE_KEY=

# Panel de curación y administración
# [OBLIGATORIO EN PRODUCCIÓN]: ADMIN_PASSWORD_HASH y JWT_SECRET
ADMIN_EMAIL=admin@vayaplan.com
ADMIN_PASSWORD_HASH=
JWT_SECRET=

# Ingesta programada y cron interno
# [OBLIGATORIO EN TODOS LOS ENTORNOS]: INTERNAL_CRON_SECRET
INTERNAL_CRON_SECRET=
# Requerido para ejecución activa de ingesta de Instagram
APIFY_TOKEN=
